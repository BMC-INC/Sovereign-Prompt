# Database: SQLite (default) or Postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/sovereign_prompt
SOVEREIGN_DB_PATH=./sovereign_prompt.db

# MCP transport: stdio (default) or sse
SOVEREIGN_MCP_TRANSPORT=stdio
# SOVEREIGN_MCP_SSE_ADDR=0.0.0.0:8790
# SOVEREIGN_DASHBOARD_ADDR=0.0.0.0:8787

# HMAC signing key (change in production!)
# SOVEREIGN_HMAC_KEY=your-production-key-here

# Logging
RUST_LOG=info
